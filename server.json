{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ContextDong/yapi-mcp",
  "title": "YApi MCP",
  "description": "Fetch YApi JSON API docs from a project URL for agent client integration.",
  "repository": {
    "url": "https://github.com/ContextDong/Yapi-Mcp",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "contextdong-yapi-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "YAPI_BASE_URL",
          "description": "YApi host URL, e.g. https://yapi.example.com",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "YAPI_TOKEN",
          "description": "Login JWT or project open token",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "YAPI_UID",
          "description": "Optional uid for login JWT cookie auth",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
